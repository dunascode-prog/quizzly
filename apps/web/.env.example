# Read at build time (next build). See README.md.

# Domain for the site, invite links and the contact address (placeholder until decided).
INVITE_DOMAIN=quizzly.app
# Android package name; also used for the Play link when PLAY_STORE_URL is unset.
ANDROID_PACKAGE=app.quizzly
# Play Store listing for the download buttons and the QR code. Leave unset until the listing exists.
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.quizzly
