# Copy to .env and fill in. Never commit .env.

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only for legacy projects that still sign tokens with a shared HS256 secret; leave empty otherwise.
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
STORAGE_BUCKET=documents

# LLM providers (free tiers). Model routing lives in config/models.yaml.
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Embeddings (run locally on CPU)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# App
# Required: local, test, staging or production. The API and worker refuse to start without it.
ENV=local
# Websites allowed to call the API from a browser (JSON list). Native apps don't need this.
CORS_ORIGINS=[]
TIMEZONE=Africa/Lagos
# Optional Expo push security token (only if the Expo project requires one).
EXPO_ACCESS_TOKEN=
# Host of share and invite links: https://{INVITE_DOMAIN}/c/{code} (PRD Q4).
INVITE_DOMAIN=quizzly.example
